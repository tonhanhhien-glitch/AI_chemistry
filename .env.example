# Template only. Copy to .env and put real values there.
# .env is git-ignored; this file is tracked, so it must hold placeholders only.

# Cloudflare Tunnel token.
# Obtain from Cloudflare Dashboard > Networking > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-real-cloudflare-tunnel-token

# Browser origins permitted by FastAPI.
CORS_ORIGINS=https://vsepr.hungntt.me,http://localhost:8080

# Generate with: openssl rand -hex 32
TEACHER_EXPORT_TOKEN=replace-with-a-long-random-token

# OpenRouter powers the optional AI explanation and chat layer. Keep the real key in .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=QNU VSEPR Learning WebApp
ENABLE_OPENROUTER=false
OPENROUTER_TIMEOUT_SECONDS=20

# OpenAI is the fallback, used only when OpenRouter fails or is disabled.
# Either provider can run alone; with neither, the deterministic template answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_OPENAI=false
OPENAI_TIMEOUT_SECONDS=20

ENABLE_PUBCHEM=true
ENABLE_PUBCHEM_PROPERTIES=true
ENABLE_NIST_CCCBDB=true
PUBCHEM_TIMEOUT_SECONDS=8
PUBCHEM_CACHE_TTL_SECONDS=86400
PUBCHEM_MAX_REQUESTS_PER_SECOND=4
PUBCHEM_MAX_CANDIDATES=20
PUBCHEM_RETRY_COUNT=2
NIST_TIMEOUT_SECONDS=6
NIST_CACHE_TTL_SECONDS=2592000
GEOMETRY_EXTERNAL_BUDGET_SECONDS=6
PROPERTY_EXTERNAL_BUDGET_SECONDS=12
ENABLE_RDKIT=false
# Container build-time switch; set true together with ENABLE_RDKIT for Docker.
INSTALL_RDKIT=false

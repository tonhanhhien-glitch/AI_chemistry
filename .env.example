# Template only. Copy to .env and put real values there.
# .env is git-ignored; this file is tracked, so it must hold placeholders only.

# Cloudflare Tunnel token.
# Obtain from Cloudflare Dashboard > Networking > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-real-cloudflare-tunnel-token

# Browser origins permitted by FastAPI.
CORS_ORIGINS=https://vsepr.hungntt.me,http://localhost:8080

# Generate with: openssl rand -hex 32
TEACHER_EXPORT_TOKEN=replace-with-a-long-random-token

ANTHROPIC_API_KEY=

ENABLE_CLAUDE=false
ENABLE_PUBCHEM=false
PUBCHEM_TIMEOUT_SECONDS=8
PUBCHEM_CACHE_TTL_SECONDS=86400
PUBCHEM_MAX_REQUESTS_PER_SECOND=4
PUBCHEM_MAX_CANDIDATES=20
PUBCHEM_RETRY_COUNT=2
ENABLE_RDKIT=false
# Container build-time switch; set true together with ENABLE_RDKIT for Docker.
INSTALL_RDKIT=false

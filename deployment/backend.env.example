# Backend environment variables for production deployment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=QNU VSEPR Learning WebApp
ENABLE_OPENROUTER=false
OPENROUTER_TIMEOUT_SECONDS=20
# OpenAI fallback; tried only after OpenRouter fails or is disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_OPENAI=false
OPENAI_TIMEOUT_SECONDS=20
CORS_ORIGINS=https://your-frontend-domain.example
LOG_LEVEL=info

# Optional external identity and structure integrations; PubChem needs no API key.
ENABLE_PUBCHEM=true
PUBCHEM_TIMEOUT_SECONDS=8
PUBCHEM_CACHE_TTL_SECONDS=86400
PUBCHEM_MAX_REQUESTS_PER_SECOND=4
PUBCHEM_MAX_CANDIDATES=20
PUBCHEM_RETRY_COUNT=2
ENABLE_RDKIT=false
# Container build-time switch; set true together with ENABLE_RDKIT for Docker.
INSTALL_RDKIT=false

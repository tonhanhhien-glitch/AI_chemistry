# Backend environment variables for production deployment.
ANTHROPIC_API_KEY=
ENABLE_CLAUDE=false
CORS_ORIGINS=https://your-frontend-domain.example
LOG_LEVEL=info

# Optional external identity and structure integrations; PubChem needs no API key.
ENABLE_PUBCHEM=true
PUBCHEM_TIMEOUT_SECONDS=8
PUBCHEM_CACHE_TTL_SECONDS=86400
PUBCHEM_MAX_REQUESTS_PER_SECOND=4
PUBCHEM_MAX_CANDIDATES=20
PUBCHEM_RETRY_COUNT=2
ENABLE_RDKIT=false
# Container build-time switch; set true together with ENABLE_RDKIT for Docker.
INSTALL_RDKIT=false
